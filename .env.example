[TEMPLATE]
# ═══════════════════════════════════════════════════════════════
#  Agency Skills - Backend (NestJS)
# ═══════════════════════════════════════════════════════════════
#
# Copia este archivo a .env y completa los valores:
#
#   cp .env.example .env
#
# ═══════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────
PORT=8004
MCP_SERVER_URL=http://localhost:8004/mcp/sse
GRPC_PORT=50051

# ── Frontend URL (para CORS y cookies) ────────────────────────
FRONTEND_BASE_URL=http://localhost:4200

# ── Database (PostgreSQL) ─────────────────────────────────────
# Usa DB_URL con formato de conexión PostgreSQL:
#   postgres://usuario:password@host:puerto/base_de_datos?sslmode=disable
# También puedes mantener los campos individuales (DB_HOST, DB_PORT, etc.)
# si prefieres no usar URL completa.
DB_URL=postgres://postgres:postgres@localhost:5432/agent_skills?sslmode=disable
DB_LOGGING=true
DB_SYNCHRONIZE=false

# ── Redis ─────────────────────────────────────────────────────
# Usa REDIS_URL con formato de conexión Redis:
#   redis://:password@host:6379/0
#   redis://host:6379  (sin password)
#   rediss://host:6379 (con TLS)
# También puedes mantener los campos individuales (REDIS_HOST, REDIS_PORT, etc.)
# si prefieres no usar URL completa.
REDIS_URL=redis://localhost:6379/0

# ── ChromaDB (vector store - opcional) ────────────────────────
CHROMADB_URL=http://localhost:8000

# ── Rules ─────────────────────────────────────────────────────
RULES_PATH=./src/rules

# ── BM25 Search ───────────────────────────────────────────────
BM25_K1=1.5
BM25_B=0.75

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=*

# ── JWT Authentication ────────────────────────────────────────
JWT_ACCESS_SECRET=change-this-to-a-random-secret-in-production
JWT_REFRESH_SECRET=change-this-to-another-random-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Email (para verificación y reset de contraseña) ───────────
EMAIL_FROM=noreply@example.com
APP_NAME=Agency Skills

# ── Google OAuth ──────────────────────────────────────────────
# Client ID y Secret de Google OAuth 2.0
# Deben coincidir con los del frontend.
#
# Cómo obtenerlos:
#   1. https://console.cloud.google.com → APIs & Services → Credentials
#   2. Create Credentials → OAuth 2.0 Client ID → Web application
#   3. Agrega "http://localhost:4200" como Authorized JavaScript origin
#      y "http://localhost:8004/api/auth/login/google" como redirect URI
#   4. El Client ID y Client Secret se muestran al crear la credencial
#
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================================
# External Services (opcionales)
# ==============================================================

# ── Exa AI (Web Search) ───────────────────────────────────────
EXA_API_KEY=
EXA_ENABLED=false

# ── Context7 (Documentación de librerías) ─────────────────────
CONTEXT7_API_KEY=
CONTEXT7_ENABLED=false

# ── Filesystem (acceso a archivos locales) ────────────────────
FS_ENABLED=false
FS_ALLOWED_PATHS=/tmp

# ── Sequential Thinking ───────────────────────────────────────
SEQUENTIAL_THINKING_ENABLED=true
